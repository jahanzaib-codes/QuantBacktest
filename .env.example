# ==============================================================================
# QuantBacktest — Institutional Backtesting Framework Configuration
# ==============================================================================

# Backtest Account Defaults
INITIAL_CAPITAL=100000.0
ACCOUNT_CURRENCY=USD
DEFAULT_BENCHMARK=SPY

# Broker Simulation Settings
DEFAULT_COMMISSION_PER_SHARE=0.005  # Interactive Brokers Equities default ($0.005/share)
DEFAULT_COMMISSION_PER_CONTRACT=0.85 # Futures default ($0.85/contract)
SLIPPAGE_BPS=3.0                    # 3 basis points (0.03%) execution slippage
MARGIN_REQUIREMENT_PCT=0.25         # 25% initial margin requirement

# Optimization & Validation Engine
DEFAULT_MONTE_CARLO_RUNS=1000
WALK_FORWARD_IN_SAMPLE_DAYS=252     # 1 year training window
WALK_FORWARD_OUT_SAMPLE_DAYS=63     # 1 quarter out-of-sample testing window
RISK_FREE_RATE_ANNUAL=0.045         # 4.5% US Treasury risk-free benchmark

# Logging
LOG_LEVEL=INFO

